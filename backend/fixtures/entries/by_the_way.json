            { "term": "a propósito", "match": "near" }
          ]
        }
      },
      "examples": [
        {
          "key": "en:by_the_way:phr#1.ex1",
          "text": "By the way, have you seen my glasses?",
          "cefr": "A2",
          "translations": { "es-419": "Por cierto, ¿has visto mis gafas?" }
        },
        {
          "key": "en:by_the_way:phr#1.ex2",
          "text": "The meeting is at ten. By the way, it's in room 4 now.",
          "cefr": "A2",
