# Copy to backend/.env for local development. Never commit .env.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Local Supabase stack started from the repo root (`supabase start`); see supabase/config.toml.
# These are the Supabase CLI's fixed local credentials, not secrets.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:34322/postgres
