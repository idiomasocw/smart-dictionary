# Copy to backend/.env for local development. Never commit .env.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Local Supabase stack started from the repo root (`supabase start`); see supabase/config.toml.
# These are the Supabase CLI's fixed local credentials, not secrets.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:34322/postgres

# Shared with the identity proxy on the BBB server. Required in production; leave it
# unset locally and the API takes the X-BBB-* headers as given.
# BBB_PROXY_SECRET=

# Request-time AI (design §7): a missing word gets a provisional entry. Each provider is
# skipped without its key; with none, lookups still work and the AI answers "unavailable".
# Use a key made for the dictionary, never the LMS's.
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# AI_MONTHLY_BUDGET_USD=5
